export type IconName = keyof typeof ICONS;

interface Props {
  name: IconName;
  class?: string;
}

const { name, class: cls = "" } = Astro.props;
---

<svg
  class:list={["i", cls]}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.8"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
  set:html={ICONS[name]}
/>

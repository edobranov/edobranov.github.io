---
// Justified rows: each photo's width follows its aspect ratio, so mixed portrait and landscape
// photos fill every row without cropping. Click a photo for the full-screen viewer.
import { Image, getImage } from "astro:assets";
import Icon from "./Icon.astro";

interface Props {
  photos: { src: ImageMetadata; alt: string }[];
}
const { photos } = Astro.props;
const full = await Promise.all(photos.map((p) => getImage({ src: p.src, width: Math.min(p.src.width, 1800) })));
---

<div class="jgrid">
  {
    photos.map((p, i) => {
      const r = (p.src.width / p.src.height).toFixed(4);
      return (
        <button
          class="jitem"
          type="button"
          data-full={full[i].src}
          data-alt={p.alt}
          style={`flex-grow: ${r}; flex-basis: calc(${r} * var(--row-h))`}
          aria-label={`Open photo ${i + 1} of ${photos.length}`}
        >
          <Image src={p.src} alt={p.alt} widths={[320, 480, 720, 960]} sizes={`(max-width: 600px) ${Math.round(Number(r) * 104)}px, (max-width: 1000px) ${Math.round(Number(r) * 180)}px, ${Math.round(Number(r) * 260)}px`} />
        </button>
      );
    })
  }
</div>

<div class="lightbox" id="lightbox" role="dialog" aria-modal="true" aria-label="Photo viewer">
  <button class="lb-btn lb-prev" type="button" aria-label="Previous photo"><Icon name="chevL" /></button>
  <figure class="lb-figure"><img id="lbImg" alt="" /></figure>
  <button class="lb-btn lb-next" type="button" aria-label="Next photo"><Icon name="chevR" /></button>
  <button class="lb-btn lb-close" type="button" aria-label="Close photo viewer"><Icon name="x" /></button>
  <div class="lb-count" id="lbCount" aria-live="polite"></div>
</div>

<script>
  const items = [...document.querySelectorAll<HTMLButtonElement>(".jitem")];
  const lightbox = document.getElementById("lightbox")!;
  const img = document.getElementById("lbImg") as HTMLImageElement;
  const count = document.getElementById("lbCount")!;
  let index = 0;
  let returnFocus: HTMLElement | null = null;

  function show() {
    const it = items[index];
    img.src = it.dataset.full!;
    img.alt = it.dataset.alt || `Photo ${index + 1} of ${items.length}`;
    count.textContent = `${index + 1} / ${items.length}`;
  }
  function open(i: number) {
    returnFocus = document.activeElement as HTMLElement;
    index = i;
    show();
    lightbox.classList.add("open");
    document.documentElement.classList.add("no-scroll");
    (lightbox.querySelector(".lb-close") as HTMLElement).focus();
  }
  function close() {
    lightbox.classList.remove("open");
    document.documentElement.classList.remove("no-scroll");
    returnFocus?.focus({ preventScroll: true });
  }
  const step = (d: number) => {
    index = (index + d + items.length) % items.length;
    show();
  };

  items.forEach((it, i) => it.addEventListener("click", () => open(i)));
  lightbox.addEventListener("click", (e) => {
    const t = e.target as Element;
    if (t.closest(".lb-prev")) step(-1);
    else if (t.closest(".lb-next")) step(1);
    else if (t.closest(".lb-close") || t === lightbox || t.classList.contains("lb-figure")) close();
  });
  document.addEventListener("keydown", (e) => {
    if (!lightbox.classList.contains("open")) return;
    if (e.key === "Escape") close();
    else if (e.key === "ArrowLeft") step(-1);
    else if (e.key === "ArrowRight") step(1);
  });

  // Swipe left/right on touch screens.
  let startX = 0;
  lightbox.addEventListener("touchstart", (e) => (startX = e.touches[0].clientX), { passive: true });
  lightbox.addEventListener("touchend", (e) => {
    const dx = e.changedTouches[0].clientX - startX;
    if (Math.abs(dx) > 50) step(dx < 0 ? 1 : -1);
  });
</script>

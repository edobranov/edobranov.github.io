---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Page not found" current="">
  <section class="section notfound">
    <div class="wrap">
      <span class="mark mark--start" aria-hidden="true"></span>
      <p class="eyebrow">404</p>
      <h1 class="display page-title">Page not found</h1>
      <p class="page-lead">The page you were looking for has moved or doesn't exist.</p>
      <div class="btn-row"><a class="btn btn-primary" href="/">Go to the home page</a></div>
    </div>
  </section>
</Layout>
